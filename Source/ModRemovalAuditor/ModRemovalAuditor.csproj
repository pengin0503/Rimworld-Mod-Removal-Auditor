<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the RimWorld 1.7 mod assembly into ../../1.7/Assemblies/.
    Game assemblies are referenced from a local RimWorld 1.7 installation and are never copied
    into the output or the repository. Point RimWorld17Dir (or the RIMWORLD_17_DIR environment
    variable) at the folder that contains Assembly-CSharp.dll and UnityStubs.dll.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ModRemovalAuditor</AssemblyName>
    <RootNamespace>ModRemovalAuditor</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.1.0</Version>
    <OutputPath>../../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <RimWorld17Dir Condition="'$(RimWorld17Dir)' == ''">$(RIMWORLD_17_DIR)</RimWorld17Dir>
  </PropertyGroup>

  <Target Name="MraCheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RimWorld17Dir)' == '' Or !Exists('$(RimWorld17Dir)/Assembly-CSharp.dll')"
           Text="RimWorld 1.7 assemblies not found. Set RIMWORLD_17_DIR (or -p:RimWorld17Dir=...) to the folder containing Assembly-CSharp.dll and UnityStubs.dll." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorld17Dir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorld17Dir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
